# Server-only Google OAuth client credentials. NEVER prefix these with VITE_ —
# a VITE_-prefixed var gets bundled into the frontend's client-side JS, which is
# exactly the mistake this backend exists to fix (see plan/plan.md M0/M3).
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Must exactly match an Authorized redirect URI configured on the OAuth client
# in Google Cloud Console. Kept as the frontend's own origin/path (rather than
# a separate backend port/path) so the existing registered redirect URI keeps
# working unchanged — the frontend dev server proxies this path to the backend.
OAUTH_REDIRECT_URI=http://localhost:5173/callback

# Origin the backend will redirect back to after a successful login, and the
# only origin its session cookie is scoped to accept requests from in dev.
FRONTEND_ORIGIN=http://localhost:5173

# 32-byte key, base64-encoded, used to encrypt refresh tokens at rest with
# AES-256-GCM. Generate one with: openssl rand -base64 32
# Rotating this key invalidates every stored refresh token (users must
# reconnect) — treat it like any other secret: never commit it, back it up
# somewhere safe if you don't want to force reconnects on redeploy.
TOKEN_ENCRYPTION_KEY=

PORT=8787

# Shared secret Google Health API webhook notifications must present in
# their Authorization header (see /webhooks/health in routes/webhook.ts).
# Set this to whatever value you configure as the endpoint's "endpoint
# authorization" secret when creating the subscription. Generate one with:
# openssl rand -base64 24
# The payload signature (GOOGLE-HEALTH-API-SIGNATURE header) is verified
# separately against Google's own published public keys — no config needed
# for that part.
WEBHOOK_AUTH_TOKEN=
